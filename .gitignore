# Root gitignore

# Dependencies
node_modules/
*/node_modules/

# Builds and outputs
dist/
*/dist/
.next/
*/.next/
out/
*/out/
build/
*/build/

# Environment variables
.env*
*/.env*
!.env.example

# Large figma dumps / design exports
figma_data/
pdf_assets/
*.pdf

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Keep project documentation; ignore incidental Markdown dumps.
*.md
*/**/*.md
!README.md
!/README.md
!/docs/
!/docs/*.md
!/AGENTS.md


# Agent & AI metadata
.agents/
*/.agents/
.agent/
*/.agent/
skills-lock.json
*/skills-lock.json
.planning/
*/.planning/
.gemini/
*/.gemini/
PRD.md
*.agent.md
!/docs/PRD.md
!/web/PRD.md
!/web/AGENTS.md
